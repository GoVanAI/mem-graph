{
  "$schema": "./cases.schema.json",
  "schema_version": "1.0.0",
  "fixture_policy": "synthetic-only",
  "cases": [
    {
      "id": "pd-01-ordinary-restart",
      "workflow": ["orient"],
      "request": { "project_id": "fixture-alpha", "query": "where were we", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-ordinary-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 101, "role": "governing", "title": "Fixture Alpha current state", "summary": "Implementation has not started.", "version": 1 }
        ]
      },
      "expected": {
        "outcome": "Return scoped candidate orientation while leaving objective and done-condition unresolved.",
        "required_signals": ["project_id=fixture-alpha", "objective=unresolved", "done_condition=unresolved"],
        "forbidden_signals": ["invented manifest", "_global content", "foreign project content"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap"], "calls": 1, "measurement_status": "executed-pass" }
    },
    {
      "id": "pd-02-valid-manifest",
      "workflow": ["orient", "find-and-inspect"],
      "request": { "project_id": "fixture-alpha", "query": "resume parser task", "include_global": false, "task_id": "fixture-task-2" },
      "source_snapshot": {
        "snapshot_id": "snapshot-manifest-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 102, "role": "manifest", "objective": "Finish parser", "done_condition": "All parser fixtures pass", "constraints": ["No schema migration"], "next_action": "Inspect failing fixture", "version": 1 },
          { "id": 103, "role": "governing", "title": "Parser decision", "summary": "Keep parsing deterministic.", "version": 1 }
        ]
      },
      "expected": {
        "outcome": "Recover all manifest lanes without changing their epistemic or authority roles.",
        "required_signals": ["objective", "done_condition", "constraints", "governing_decisions", "current_state", "open_state", "next_action"],
        "forbidden_signals": ["context promoted to governing", "database write"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap", "memory_get"], "calls": 2, "measurement_status": "executed-pass" }
    },
    {
      "id": "pd-03-fresh-contradiction",
      "workflow": ["orient", "find-and-inspect", "review-and-learn"],
      "request": { "project_id": "fixture-alpha", "query": "resume deployment", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-contradiction-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 104, "role": "governing", "title": "Deployment target", "summary": "Use target A.", "version": 2 },
          { "id": 105, "role": "contradiction", "summary": "Target A was retired yesterday.", "fresh": true, "affects": [104] }
        ]
      },
      "expected": {
        "outcome": "Show the warning immediately and require evidence inspection before relying on the affected claim.",
        "required_signals": ["contradiction warning", "affected_source=104", "requires_expansion=true"],
        "forbidden_signals": ["automatic rejection", "silent reliance on source 104"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap", "epistemic_get", "cognitive_event_trace"], "calls": 3, "measurement_status": "executed-pass" }
    },
    {
      "id": "pd-04-long-governing-record",
      "workflow": ["orient", "find-and-inspect"],
      "request": { "project_id": "fixture-alpha", "query": "load operating constraints", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-long-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 106, "role": "governing", "title": "Long operating contract", "summary": "A bounded preview.", "content_bytes": 12000, "version": 4 }
        ]
      },
      "expected": {
        "outcome": "Return a safe preview and explicit expansion requirement without claiming the omitted constraints are complete.",
        "required_signals": ["preview", "source_id=106", "requires_expansion=true", "omitted_content_bytes"],
        "forbidden_signals": ["complete=true", "silent truncation"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap", "memory_get"], "calls": 2, "measurement_status": "executed-gap" }
    },
    {
      "id": "pd-05-wrong-project",
      "workflow": ["orient", "find-and-inspect"],
      "request": { "project_id": "fixture-alpha", "query": "current implementation", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-scope-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 107, "project_id": "fixture-alpha", "role": "governing", "summary": "Allowed source." },
          { "id": 108, "project_id": "fixture-beta", "role": "governing", "summary": "Foreign source." },
          { "id": 109, "project_id": "_global", "role": "governing", "summary": "Global source not requested." }
        ]
      },
      "expected": {
        "outcome": "Return only the exact-project source and never suggest expansion to excluded records.",
        "required_signals": ["source_id=107", "include_global=false"],
        "forbidden_signals": ["source_id=108", "source_id=109", "foreign expansion instruction"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap"], "calls": 1, "measurement_status": "executed-gap" }
    },
    {
      "id": "pd-06-source-revised",
      "workflow": ["orient", "find-and-inspect"],
      "request": { "project_id": "fixture-alpha", "query": "inspect source 110", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-revision-v1-to-v2",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 110, "role": "governing", "orientation_version": 1, "expansion_version": 2, "summary": "The source changed before expansion." }
        ]
      },
      "expected": {
        "outcome": "Detect the source-version change and refresh orientation instead of combining snapshots.",
        "required_signals": ["version_mismatch", "refresh_required=true"],
        "forbidden_signals": ["mixed snapshot", "stale source adopted"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap", "memory_get", "cognitive_agent_bootstrap"], "calls": 3, "measurement_status": "executed-pass" }
    },
    {
      "id": "pd-07-history-heavy",
      "workflow": ["orient", "find-and-inspect"],
      "request": { "project_id": "fixture-alpha", "query": "current decision and its history", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-history-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 111, "role": "governing", "status": "active", "summary": "Current decision." },
          { "id": 112, "role": "history", "status": "superseded", "summary": "Prior decision." },
          { "id": 113, "role": "history", "status": "archived", "summary": "Early exploration." }
        ]
      },
      "expected": {
        "outcome": "Keep current orientation readable and expose history through an explicit bounded expansion.",
        "required_signals": ["current_source=111", "history_available=true", "history_count=2"],
        "forbidden_signals": ["history treated as governing", "all history in first response"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap", "memory_search"], "calls": 2, "measurement_status": "executed-pass" }
    },
    {
      "id": "pd-08-degraded-input",
      "workflow": ["orient", "find-and-inspect"],
      "request": { "project_id": "fixture-alpha", "query": "resume task", "include_global": false, "manifest": "malformed-fixture" },
      "source_snapshot": {
        "snapshot_id": "snapshot-degraded-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 114, "role": "context", "summary": "Base orientation remains available." },
          { "id": 115, "role": "missing-source", "available": false }
        ]
      },
      "expected": {
        "outcome": "Preserve base orientation, name unavailable details, and give an available scoped fallback.",
        "required_signals": ["base_orientation_available=true", "manifest_invalid", "missing_source=115", "fallback"],
        "forbidden_signals": ["bootstrap failure", "invented missing content", "hidden legacy tool"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap", "memory_search"], "calls": 2, "measurement_status": "executed-pass" }
    }
  ]
}
