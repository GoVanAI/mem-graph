      "id": "pd-01-ordinary-restart",
      "workflow": ["orient"],
      "request": { "project_id": "fixture-alpha", "query": "where were we", "include_global": false },
      "source_snapshot": {
        "snapshot_id": "snapshot-ordinary-v1",
        "project_id": "fixture-alpha",
        "records": [
          { "id": 101, "role": "governing", "title": "Fixture Alpha current state", "summary": "Implementation has not started.", "version": 1 }
        ]
      },
      "expected": {
        "outcome": "Return scoped candidate orientation while leaving objective and done-condition unresolved.",
        "required_signals": ["project_id=fixture-alpha", "objective=unresolved", "done_condition=unresolved"],
        "forbidden_signals": ["invented manifest", "_global content", "foreign project content"]
      },
      "baseline_trace": { "legacy_tools": ["cognitive_agent_bootstrap"], "calls": 1, "measurement_status": "executed-pass", "phase_d_receipt_pointer": "pd-01-ordinary-restart" },
      "fixture_intent": "lexical_discovery",
      "required_predicates": [
        { "pointer": "/scope/project_id", "operator": "equals", "value": "fixture-alpha" },
        { "pointer": "/scope/include_global", "operator": "equals", "value": false },
        { "pointer": "/scope/global_inclusion", "operator": "equals", "value": "disabled" },
        { "pointer": "/orientation/status", "operator": "equals", "value": "partial" },
        { "pointer": "/orientation/task_state", "operator": "equals", "value": "not_requested" },
        { "pointer": "/task/objective/status", "operator": "equals", "value": "unresolved" },
        { "pointer": "/task/definition_of_done/status", "operator": "equals", "value": "unresolved" },
        { "pointer": "/task/constraints/status", "operator": "equals", "value": "unresolved" },
        { "pointer": "/task/objective/statement", "operator": "not_exists" },
        { "pointer": "/task/definition_of_done/statement", "operator": "not_exists" },
        { "pointer": "/task/next_action/statement", "operator": "not_exists" }
      ],
      "forbidden_predicates": [],
      "case_notes": "Lexical discovery case: declares a query but no manifest. Required predicates prove the envelope acknowledges scope and refuses to invent objective, definition_of_done, or next_action statements (statement pointers must not resolve). Counterexample: an envelope that invents an objective statement (PD01 counterexample) must fail this plan."
    },
