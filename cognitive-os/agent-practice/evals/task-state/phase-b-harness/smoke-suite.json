{
  "schema_version": 1,
  "name": "task-state-phase-b-runner-smoke",
  "defaults": {
    "timeout_ms": 30000,
    "grader_timeout_ms": 10000,
    "kill_grace_ms": 1000,
    "runs": 1,
    "max_capture_bytes": 1048576
  },
  "variants": [
    {
      "id": "mock-worker",
      "provider": "custom",
      "command": "node",
      "args": ["{suite}/workers/mock-worker.mjs"]
    }
  ],
  "cases": [
    {
      "id": "write-pass-artifact",
      "fixture": "fixtures/smoke",
      "prompt": "Create answer.txt in the workspace containing exactly PASS followed by a newline.",
      "minimum_score": 100,
      "graders": [
        {"id": "worker-exited-cleanly", "type": "process_exit", "expected": 0, "hard_gate": true, "weight": 1},
        {"id": "artifact-exists", "type": "file_exists", "path": "answer.txt", "hard_gate": true, "weight": 1},
        {"id": "artifact-content", "type": "command", "command": "node", "args": ["{suite}/graders/check-pass.mjs", "{workspace}/answer.txt"], "expected_exit": 0, "hard_gate": true, "weight": 1},
        {"id": "no-forbidden-file", "type": "file_not_exists", "path": "forbidden.txt", "hard_gate": true, "weight": 1}
      ]
    }
  ]
}
