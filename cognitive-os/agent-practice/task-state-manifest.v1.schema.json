{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GoVanAI/mem-graph/cognitive-os/agent-practice/task-state-manifest.v1.schema.json",
  "title": "Mem-Graph Task-State Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "revision",
    "project_id",
    "task_id",
    "adoption",
    "task",
    "lane_requirements",
    "event_scope",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "revision": { "type": "integer", "minimum": 1 },
    "project_id": { "$ref": "#/$defs/scopedId" },
    "task_id": { "$ref": "#/$defs/scopedId" },
    "include_global": { "type": "boolean", "default": false },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": {
          "enum": ["proposed", "operator_adopted", "superseded"]
        },
        "source": { "$ref": "#/$defs/sourceRef" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "definition_of_done", "constraints"],
      "properties": {
        "objective": { "$ref": "#/$defs/sourcedStatement" },
        "definition_of_done": { "$ref": "#/$defs/sourcedStatement" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourcedStatement" },
          "maxItems": 50
        },
        "expected_next_action": { "$ref": "#/$defs/sourcedStatement" }
      }
    },
    "lane_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governing",
        "current_state",
        "open_state",
        "evidence",
        "context_only",
        "warnings"
      ],
      "properties": {
        "governing": { "$ref": "#/$defs/laneRequirement" },
        "current_state": { "$ref": "#/$defs/laneRequirement" },
        "open_state": { "$ref": "#/$defs/laneRequirement" },
        "evidence": { "$ref": "#/$defs/laneRequirement" },
        "context_only": { "$ref": "#/$defs/laneRequirement" },
        "warnings": { "$ref": "#/$defs/laneRequirement" }
      }
    },
    "governing_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRef" },
      "maxItems": 50,
      "uniqueItems": true
    },
    "event_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "task_id", "allow_legacy_v1_context"],
      "properties": {
        "project_id": { "$ref": "#/$defs/scopedId" },
        "task_id": { "$ref": "#/$defs/scopedId" },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "after_sequence": { "type": "integer", "minimum": 0 },
        "observed_after": { "type": "string", "format": "date-time" },
        "allow_legacy_v1_context": { "type": "boolean", "default": false }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_after": { "type": "string", "format": "date-time" },
        "last_validated_at": { "type": "string", "format": "date-time" },
        "validation_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" },
          "maxItems": 50,
          "uniqueItems": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items_per_lane"],
      "properties": {
        "max_items_per_lane": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "max_preview_characters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000,
          "default": 500
        }
      }
    }
  },
  "$defs": {
    "scopedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s]+$"
    },
    "laneRequirement": {
      "enum": ["required", "optional", "disabled"]
    },
    "sourcedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "required", "sources"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "required": { "type": "boolean" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/sourceRef" },
          "uniqueItems": true
        }
      }
    },
    "sourceRef": {
      "oneOf": [
        { "$ref": "#/$defs/memoryRef" },
        { "$ref": "#/$defs/cognitiveEventRef" },
        { "$ref": "#/$defs/epistemicRecordRef" },
        { "$ref": "#/$defs/artifactRef" }
      ]
    },
    "memoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "project_id"],
      "properties": {
        "kind": { "const": "memory" },
        "id": { "type": "integer", "minimum": 1 },
        "project_id": { "$ref": "#/$defs/scopedId" },
        "expected_updated_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cognitiveEventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event_id", "project_id", "task_id"],
      "properties": {
        "kind": { "const": "cognitive_event" },
        "event_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "project_id": { "$ref": "#/$defs/scopedId" },
        "task_id": { "$ref": "#/$defs/scopedId" },
        "expected_event_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "epistemicRecordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "record_id", "project_id"],
      "properties": {
        "kind": { "const": "epistemic_record" },
        "record_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "project_id": { "$ref": "#/$defs/scopedId" },
        "expected_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project_id", "path", "sha256"],
      "properties": {
        "kind": { "const": "artifact" },
        "project_id": { "$ref": "#/$defs/scopedId" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
