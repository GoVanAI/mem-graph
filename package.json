{
  "name": "@opencode-ai/mem-graph",
  "version": "0.2.1",
  "description": "MCP server for graph-relational memory with an additive Cognitive OS evidence and guidance sidecar. Backed by better-sqlite3.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "mem-graph": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "practice:generate": "node cognitive-os/agent-practice/generate-adapters.mjs",
    "practice:check": "node cognitive-os/agent-practice/generate-adapters.mjs --check",
    "practice:grade": "tsx cognitive-os/agent-practice/evals/grade-transcript.ts",
    "practice:minimax": "tsx cognitive-os/agent-practice/evals/review-with-minimax.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "^2.1.9"
  }
}
